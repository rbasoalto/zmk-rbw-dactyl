#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define SYSTEM  3

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {

            bindings = <
    &kp ESC     &kp ESC     &kp N1   &kp N2     &kp N3    &kp N4    &kp N5                               &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp MINUS
    &kp TAB     &kp TAB     &kp Q    &kp W      &kp E     &kp R     &kp T                                &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC  &kp BSPC
    &kp LCTRL   &kp LCTRL   &kp A    &kp S      &kp D     &kp F     &kp G                                &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp SQT
    &kp LSHIFT  &kp LSHIFT  &kp Z    &kp X      &kp C     &kp V     &kp B                                &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp ESC   &kp ESC
                                     &kp LEFT   &kp RIGHT                                                                    &kp UP    &kp DOWN
                                                          &kp SPACE &kp SPACE &kp SPACE        &kp ENTER &kp ENTER &kp ENTER
                                                                    &kp BKSP  &kp BKSP         &kp TAB   &kp TAB
            >;
        };

    };
};
